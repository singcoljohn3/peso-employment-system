{
    "compilerOptions": {
        "baseUrl": ".",
        "jsx": "react-jsx",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "target": "ESNext",
        "allowJs": true,
        "noEmit": true,
        "isolatedModules": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "strict": false,
        "paths": {
            "@/*": ["resources/js/*"]
        }
    },
    "include": [
        "resources/js/**/*.js",
        "resources/js/**/*.jsx"
    ],
    "exclude": [
        "node_modules",
        "public",
        "vendor",
        "storage",
        "bootstrap/cache"
    ]
}
